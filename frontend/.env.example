# ==============================================================================
# authentic-et Frontend Environment Configuration
# ==============================================================================
# In local development or unified Docker deployment, defaults to reverse proxy: /api/v1
# If deploying frontend independently (Vercel, Netlify, S3, Cloudflare Pages):
# point this to your production backend URL, e.g.:
# VITE_API_BASE_URL=https://api.authentic-et.com/api/v1

VITE_API_BASE_URL=/api/v1
