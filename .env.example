# ==============================================================================
# authentic-et: Multi-Rail Payment Verification & Provisioning Platform
# Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5151
LOG_LEVEL=info
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5151


# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
ADMIN_EMAIL=admin@authentic-et.dev
ADMIN_PASSWORD=admin-password-change-me
# Set to 'true' to allow anyone on the public internet to sign up for accounts
ALLOW_REGISTRATION=false

# Headless & Preset API Key Mode (Zero UI / Direct Microservice)
# Set to 'true' if running pure headless API without serving the React web interface
DISABLE_UI=false

# Preset static API keys (comma-separated). Useful when deploying headless without using the web UI.
# Any request supplying 'X-API-KEY: <key>' or 'Authorization: Bearer <key>' matching these will be authenticated immediately.
API_KEY=sk_pv_live_your_preset_secret_key_here
PRESET_API_KEYS=sk_pv_live_prod_key_1,sk_pv_test_key_2
MASTER_TOKEN=sk_pv_root_master_token_for_automation

# Database Configuration
# Options: 'postgres' or 'sqlite'
DATABASE_DRIVER=postgres

# PostgreSQL Connection (used if DATABASE_DRIVER=postgres)
DATABASE_URL=postgres://authentic:authentic_password@postgres:5432/authentic?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# SQLite Configuration (used if DATABASE_DRIVER=sqlite)
SQLITE_PATH=/data/authentic.db

# Multi-Rail Payment Providers Configuration
# Comma-separated list of active providers (options: cbe, telebirr, boa, mock)
PAYMENT_PROVIDERS_ENABLED=mock,cbe,telebirr,boa

# Commercial Bank of Ethiopia (CBE) Settings
CBE_ACCOUNT_NAME=Your Merchant Account Name
CBE_ACCOUNT_NUMBER=1000123456789
CBE_API_URL=https://api.cbe.com.et/v2/verify
CBE_API_KEY=

# Telebirr (Ethio Telecom) Settings
TELEBIRR_MERCHANT_NAME=Your Telebirr Name
TELEBIRR_RECEIVER_PHONE=251911234567
TELEBIRR_API_URL=https://app.ethiotelecom.et/telebirr
TELEBIRR_APP_KEY=

# Bank of Abyssinia (BOA) Settings
BOA_ACCOUNT_NAME=Your BOA Account Name
BOA_ACCOUNT_NUMBER=2000123456789
BOA_API_URL=https://api.bankofabyssinia.com/verify

# Mock Provider (Sandbox) Settings
MOCK_ALLOW_INSTANT_CONFIRM=true

# Background Outbox Worker Configuration
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL=3s
WORKER_MAX_RETRIES=5

# Automated Data Retention & Pruning Configuration
# Automatically prunes stale verifications, failed records, completed jobs, and audit logs
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
TRANSACTION_RETENTION_DAYS=90       # Days to retain claimed payments (0 or -1 to retain indefinitely)
FAILED_RETENTION_DAYS=30            # Days to retain failed / expired transaction attempts
UNCLAIMED_EXPIRY_HOURS=72           # Hours after which pending payments are transitioned to EXPIRED
AUDIT_RETENTION_DAYS=180            # Days to retain immutable financial audit logs (0 to retain indefinitely)
COMPLETED_JOBS_RETENTION_DAYS=14    # Days to retain successfully processed outbox jobs
DRY_RUN_CLEANUP=false               # If true, runs retention analysis without executing deletions
